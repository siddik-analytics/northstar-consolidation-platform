model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["Date", "Entity", "Business Unit", "Account", "Cost Centre", "Consolidation Layer", "Reporting Basis", "Currency", "Scenario", "Measure Line", "Comparison", "Debt Instrument", "Capital Project", "Financials", "Financial Detail", "Variance", "Balance Sheet", "Cash Flow", "Working Capital", "Covenants", "Debt", "Headcount", "CapEx", "FX", "Layer Bridge", "Period Basis", "Measures"]

	annotation PBI_ProTooling = ["DevMode"]

ref table 'Period Basis'
ref table 'Date'
ref table 'Entity'
ref table 'Business Unit'
ref table 'Account'
ref table 'Cost Centre'
ref table 'Consolidation Layer'
ref table 'Reporting Basis'
ref table 'Currency'
ref table 'Scenario'
ref table 'Measure Line'
ref table 'Comparison'
ref table 'Debt Instrument'
ref table 'Capital Project'
ref table 'Financials'
ref table 'Financial Detail'
ref table 'Variance'
ref table 'Balance Sheet'
ref table 'Cash Flow'
ref table 'Working Capital'
ref table 'Covenants'
ref table 'Debt'
ref table 'Headcount'
ref table 'CapEx'
ref table 'FX'
ref table 'Layer Bridge'
ref table Measures

ref cultureInfo en-GB
