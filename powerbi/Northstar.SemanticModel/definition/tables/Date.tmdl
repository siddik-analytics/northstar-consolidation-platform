	column period_key
		dataType: int64
		isHidden
		isKey
		lineageTag: 07370d91-bca2-5e18-8144-59deaa1c99ac
		summarizeBy: none
		sourceColumn: period_key

		annotation SummarizationSetBy = Automatic

