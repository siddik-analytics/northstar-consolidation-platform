/// Scenario and version in ONE dimension, keyed by version, with a Scenario -> Version
/// hierarchy. A version belongs to exactly one scenario, so these are two levels of one thing
/// rather than two dimensions; splitting them would snowflake the model and give a fact two
/// paths to the same concept. Every version the master governs is here, including PY_DERIVED --
/// the derived version for Prior Year (ADR-0027). Reserved scenarios are absent by
/// construction: the mart never publishes them, so Downside cannot be selected into an empty
/// report that looks like a real one.
table 'Scenario'
	lineageTag: bbe1d3b2-a616-57bc-b8b0-360f46c6127b

	column version_code
		dataType: string
		isKey
		lineageTag: 514142d9-084e-50c4-8668-078abdab3237
		summarizeBy: none
		sourceColumn: version_code

		annotation SummarizationSetBy = Automatic

	column scenario_code
		dataType: string
		lineageTag: 20711935-fe2a-55c2-a422-385c5799b2fd
		summarizeBy: none
		sourceColumn: scenario_code

		annotation SummarizationSetBy = Automatic

	column scenario_name
