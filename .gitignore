# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --------------------------------------------------------------- generated data
# Phase 2 regenerates every byte of this from a fixed seed in about 25 seconds, so the
# bulk artefacts are not committed. What IS committed is everything needed to prove a
# rebuild is identical: the manifest with per-file checksums, the control results, the
# committed samples and the small reference masters.
# See docs/synthetic-data-methodology.md.

# 166 MB of native ERP extracts
data/raw/*
!data/raw/.gitkeep

# journal lines (10 MB) and revenue detail (1 MB)
data/reference/*.parquet

# fault variant files; the expected-results manifest beside them IS committed
data/faults/*/

# pipeline layers built in Phases 3-5
data/10_staging/*
data/20_warehouse/*
data/30_marts/*
data/90_exports/*
!data/**/.gitkeep
*.duckdb
*.duckdb.wal

# Office and Power BI build artefacts
~$*.xlsx
~$*.docx
*.pbix
powerbi/**/.pbi/localSettings.json
powerbi/**/*.abf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
